---
layout: base.njk
title: Info
nav: info
summary: Cole Calfee, Nashville, Tennessee / North Georgia. Email and Instagram.
ogSource: studio.jpg
permalink: /info/
---
<main id="main" class="wrap">
<div class="grid info">
<div class="lede">
<h1 class="title">{{ site.name }}</h1>
<p class="cap">{{ site.location }}</p>
</div>
<figure class="photo">{% picture "studio.jpg", "A motion-blurred figure walking past colorful paintings on a studio wall.", "(min-width: 1024px) 62vw, calc(100vw - 32px)", true %}</figure>
<dl class="contact">
<div><dt class="cap">Email</dt><dd><!--email_off--><a href="mailto:{{ site.email }}">{{ site.email }}</a><!--/email_off--></dd></div>
<div><dt class="cap">Instagram</dt><dd><a href="{{ site.instagram.url }}" rel="noopener">{{ site.instagram.handle }} <span class="arrow" aria-hidden="true">↗&#xFE0E;</span></a></dd></div>
</dl>
</div>
</main>
