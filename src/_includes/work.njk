---
layout: base.njk
ogType: article
---
{%- set works = collections.works -%}
{%- set paged = [] -%}
{%- for w in works %}{% if w | hasPage %}{% set paged = (paged.push(w), paged) %}{% endif %}{% endfor -%}
{%- set pos = 0 -%}
{%- for w in paged %}{% if w.url == page.url %}{% set pos = loop.index0 %}{% endif %}{% endfor -%}
{%- set no = 0 -%}
{%- for w in works %}{% if w.url == page.url %}{% set no = loop.index %}{% endif %}{% endfor -%}
{%- set prev = paged[pos - 1] if pos > 0 else paged[paged.length - 1] -%}
{%- set next = paged[pos + 1] if pos < paged.length - 1 else paged[0] -%}
{%- set go -%}
<a href="{{ prev.url }}" rel="prev" aria-label="Previous: {{ prev.data.title }}">← Previous</a><a href="{{ next.url }}" rel="next" aria-label="Next: {{ next.data.title }}">Next →</a><a href="/index/#{{ page.fileSlug }}">Index</a><a href="/">Home</a>{% include "colorway-button.njk" %}
{%- endset -%}
<main id="main" class="split">
<header class="about">
<div>
<p class="no">{{ no | pad }} / {{ works.length | pad }}</p>
<h1>{{ title }}</h1>
<dl class="meta">
{%- if role %}<dt>Role</dt><dd>{{ role }}</dd>{% endif %}
{%- if client %}<dt>Client</dt><dd>{{ client }}</dd>{% endif %}
<dt>Year</dt><dd>{{ year }}</dd>
<dt>Discipline</dt><dd>{{ disciplines | join(", ") }}</dd>
</dl>
{%- if content | trim %}
<div class="desc">{{ content | safe }}</div>
{%- endif %}
{%- if link or links or see %}
<p class="go">
{%- if link %}<a href="{{ link.href }}" rel="noopener">{{ link.label }} <span aria-hidden="true">↗&#xFE0E;</span></a>{% endif %}
{%- for l in links %}<a href="{{ l.href }}" rel="noopener">{{ l.label }} <span aria-hidden="true">↗&#xFE0E;</span></a>{% endfor %}
{%- if see %}<a href="{{ see.href }}">{{ see.label }} →</a>{% endif %}
</p>
{%- endif %}
{%- if releases %}
<section class="rel" aria-labelledby="rel">
<h2 id="rel">Releases</h2>
<ul>
{%- for r in releases %}
<li><a href="{{ r.href }}" rel="noopener">{{ r.title }} <span aria-hidden="true">↗&#xFE0E;</span><span class="vh"> (listen)</span></a></li>
{%- endfor %}
</ul>
</section>
{%- endif %}
<nav class="go" aria-label="More work">{{ go | safe }}</nav>
</div>
</header>
<div class="media">
{% media media %}
</div>
<nav class="go end" aria-label="More work, end of page">{{ go | safe }}</nav>
</main>
