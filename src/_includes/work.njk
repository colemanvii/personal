---
layout: base.njk
ogType: article
---
{%- set works = collections.works -%}
{%- set paged = [] -%}
{%- for w in works %}{% if w | hasPage %}{% set paged = (paged.push(w), paged) %}{% endif %}{% endfor -%}
{%- set pos = 0 -%}
{%- for w in paged %}{% if w.url == page.url %}{% set pos = loop.index0 %}{% endif %}{% endfor -%}
{%- set prev = paged[pos - 1] if pos > 0 else paged[paged.length - 1] -%}
{%- set next = paged[pos + 1] if pos < paged.length - 1 else paged[0] -%}
<dl class="rows">
{%- if role %}<div class="r"><dt class="l">role</dt><dd>{{ role }}</dd></div>{% endif %}
{%- if client and client != title and client != "Independent" %}<div class="r"><dt class="l">for</dt><dd>{{ client }}</dd></div>{% endif %}
<div class="r"><dt class="l">year</dt><dd>{{ year }}</dd></div>
{%- if (disciplines | join(", ") | lower) != (role | lower) %}<div class="r"><dt class="l">discipline</dt><dd>{{ disciplines | join(", ") }}</dd></div>{% endif %}
{%- if link or links %}
<div class="r"><dt class="l">elsewhere</dt><dd class="list">
{%- if link %}<a class="ext" href="{{ link.href }}" rel="noopener">{{ link.label }}</a>{% endif %}
{%- for l in links %}{% if not loop.first or link %}<br>{% endif %}<a class="ext" href="{{ l.href }}" rel="noopener">{{ l.label }}</a>{% endfor %}
</dd></div>
{%- endif %}
</dl>
{%- if content | trim %}
<div class="r"><span></span><div class="prose">{{ content | safe }}</div></div>
{%- endif %}
<div class="media">
{% media media %}
{%- if releases %}
<section class="r releases" aria-labelledby="releases">
<h2 class="l" id="releases">releases</h2>
<ul class="list">
{%- for r in releases %}
<li><a class="ext" href="{{ r.href }}" rel="noopener">{{ r.title }}</a></li>
{%- endfor %}
</ul>
</section>
{%- endif %}
</div>
<nav class="rows" aria-label="More work">
<div class="r"><span class="l">previous</span><a href="{{ prev.url }}" rel="prev">{{ prev.data.title }}</a></div>
<div class="r"><span class="l">next</span><a href="{{ next.url }}" rel="next">{{ next.data.title }}</a></div>
<div class="r"><span class="l">all work</span><a href="/index/#{{ page.fileSlug }}">index</a></div>
</nav>
