{%- set cw = site.colorways -%}
<style>
/* Colourways. The default is set here; the other applies when the visitor chooses it. */
:root{--paper:{{ cw.paper.bg }};--ink:{{ cw.paper.fg }}}
:root[data-colorway="earth"]{--paper:{{ cw.earth.bg }};--ink:{{ cw.earth.fg }};color-scheme:dark}
/* The switch is one more word in each page's row of links: DARK, or LIGHT when brown.
   It always takes five letters of room, so switching never moves the other links, and
   like the links on / it is a 44px target without taking 44px of the layout. */
.cwt{display:none;margin:-14px 0;padding:14px 0;border:0;background:none;color:inherit;font:inherit;letter-spacing:inherit;text-transform:uppercase;text-align:left;cursor:pointer;-webkit-tap-highlight-color:transparent}
.cw-on .cwt{display:inline-block}
.cwt span{display:block;width:5ch}
.cwt .l,[data-colorway="earth"] .cwt .d{display:none}
[data-colorway="earth"] .cwt .l{display:block}
.cwt:hover span{text-decoration:underline;text-underline-offset:4px}
.cwt:focus-visible{outline:none}
.cwt:focus-visible span{outline:1px solid currentColor;outline-offset:5px}
</style>
<script>(function(r){r.classList.add("cw-on");try{if(localStorage.getItem("colorway")==="earth")r.dataset.colorway="earth"}catch(e){}})(document.documentElement)</script>
