{%- set cw = site.colorways -%}
<div class="cw" role="group" aria-label="Colourway" hidden><button type="button" data-cw="paper" aria-label="{{ cw.paper.label }}" aria-pressed="true"></button><button type="button" data-cw="earth" aria-label="{{ cw.earth.label }}" aria-pressed="false"></button></div>
<script>
(function(){
  var r=document.documentElement,g=document.querySelector(".cw"),m=document.querySelector('meta[name="theme-color"]');
  var bg={paper:"{{ cw.paper.bg }}",earth:"{{ cw.earth.bg }}"},b=[].slice.call(g.querySelectorAll("button"));
  function set(c,save){
    c=c==="earth"?"earth":"paper";
    if(c==="earth")r.dataset.colorway=c;else delete r.dataset.colorway;
    if(m)m.setAttribute("content",bg[c]);
    b.forEach(function(x){x.setAttribute("aria-pressed",String(x.dataset.cw===c))});
    if(save)try{localStorage.setItem("colorway",c)}catch(e){}
  }
  function stored(){try{return localStorage.getItem("colorway")}catch(e){}}
  b.forEach(function(x){x.addEventListener("click",function(){set(x.dataset.cw,true)})});
  addEventListener("storage",function(e){if(e.key==="colorway")set(e.newValue)});
  addEventListener("pageshow",function(){set(stored())});
  set(stored());
  g.hidden=false;
})();
</script>
