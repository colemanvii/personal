{%- set cw = site.colorways -%}
<script>
(function(){
  var r=document.documentElement,m=document.querySelector('meta[name="theme-color"]'),bg={paper:"{{ cw.paper.bg }}",earth:"{{ cw.earth.bg }}"};
  function set(c,save){
    c=c==="earth"?"earth":"paper";
    if(c==="earth")r.dataset.colorway=c;else delete r.dataset.colorway;
    if(m)m.setAttribute("content",bg[c]);
    if(save)try{localStorage.setItem("colorway",c)}catch(e){}
  }
  function stored(){try{return localStorage.getItem("colorway")}catch(e){}}
  [].forEach.call(document.querySelectorAll(".cwt"),function(b){b.addEventListener("click",function(){set(r.dataset.colorway==="earth"?"paper":"earth",true)})});
  addEventListener("storage",function(e){if(e.key==="colorway")set(e.newValue)});
  addEventListener("pageshow",function(){set(stored())});
  set(stored());
})();
</script>
