---
layout: base.njk
title: Index
summary: Every work by Cole Calfee — creative direction, identity, web, film, editorial, music, illustration, photography and painting.
permalink: /index/
---
{%- set works = collections.works -%}
<main id="main" class="col idx">
<h1>Index</h1>
<ol class="list">
{%- for w in works %}
<li id="{{ w.page.fileSlug }}">
{%- if w | hasPage %}
<a href="{{ w.url }}">
{%- else %}
<a href="{{ w.data.link.href }}" rel="noopener">
{%- endif %}
<span class="no">{{ loop.index | pad }}</span><span class="t">{{ w.data.title }}{% if not (w | hasPage) %} <span aria-hidden="true">↗&#xFE0E;</span><span class="vh"> (opens {{ w.data.link.label }})</span>{% endif %}</span><span class="d">{{ w.data.disciplines | join(", ") }}</span><span class="y">{{ w.data.year }}</span></a></li>
{%- endfor %}
</ol>
<nav class="go" aria-label="Site"><a href="/available/">Available</a><a href="/info/">Contact</a><a href="/">Home</a>{% include "colorway-button.njk" %}</nav>
</main>
<script>
/* Links from the old site (/index/#kashus) go to the work's page. */
(function(){
  var old={freeman:'freeman-general-contracting',kashus:'kashus-culpepper',scout:'scout-motors',ronnie:'ronnie-hodges-performance-horses',teton:'teton-valley-ranch','ramsey-hill':'ramsey-hill-contracting',habitat:'habitat-ranch',corey:'corey-kent',joseph:'joseph-martin',cowboyer:'the-cowboyer',mags:'mags-duval'};
  var h=decodeURIComponent(location.hash.slice(1));
  if(old[h])location.replace('/work/'+old[h]+'/');
})();
</script>
