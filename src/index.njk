---
layout: base.njk
title: Index
heading: Index
summary: Every work by Cole Calfee, by the year it began.
permalink: /index/
---
<div class="rows works">
{%- for g in collections.works | byYear %}
<section class="r" aria-labelledby="y-{{ g.year }}">
<h2 class="l" id="y-{{ g.year }}">{{ g.year }}</h2>
<ul class="list">
{%- for w in g.items %}
<li id="{{ w.page.fileSlug }}">
{%- if w | hasPage %}
<a href="{{ w.url }}"><span class="t u">{{ w.data.title }}</span> <span class="note">{{ w.data.disciplines | join(", ") | lower }}</span></a>
{%- else %}
<a href="{{ w.data.link.href }}" rel="noopener"><span class="t u ext">{{ w.data.title }}</span> <span class="note">{{ w.data.disciplines | join(", ") | lower }}</span><span class="vh"> (opens {{ w.data.link.label }})</span></a>
{%- endif %}
</li>
{%- endfor %}
</ul>
</section>
{%- endfor %}
</div>
<script>
/* Links from the old site (/index/#kashus) go to the work's page. */
(function(){
  var old={freeman:'freeman-general-contracting',kashus:'kashus-culpepper',scout:'scout-motors',ronnie:'ronnie-hodges-performance-horses',teton:'teton-valley-ranch','ramsey-hill':'ramsey-hill-contracting',habitat:'habitat-ranch',corey:'corey-kent',joseph:'joseph-martin',cowboyer:'the-cowboyer',mags:'mags-duval'};
  var h=decodeURIComponent(location.hash.slice(1));
  if(old[h])location.replace('/work/'+old[h]+'/');
})();
</script>
