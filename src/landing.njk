<style>
@font-face{font-family:GeistMono;src:url('/fonts/geist-mono-v6.woff2') format('woff2');font-display:swap}
/* Until Geist Mono arrives, text is set in a system monospace scaled to Geist Mono's
   0.6em character width, so nothing moves when it swaps in. */
@font-face{font-family:GeistMonoFallback;src:local("Menlo Regular"),local("Menlo-Regular"),local("Menlo");size-adjust:99.66%}
@font-face{font-family:GeistMonoFallbackWin;src:local("Consolas");size-adjust:109.13%}
@font-face{font-family:GeistMonoFallbackLinux;src:local("DejaVu Sans Mono"),local("DejaVuSansMono");size-adjust:99.66%}
*{box-sizing:border-box}
/* One stationary viewport. The page is the height of the small viewport (browser
   toolbars shown), which does not change as toolbars move, so it never exceeds what
   is visible and nothing on it moves. Older browsers fall back to 100% of the html
   element. Auto margins centre the composition but give way when zoomed text is
   taller than the screen, so the page then scrolls normally and nothing is cut off. */
html{height:100%;overscroll-behavior:none}
html,body{margin:0;background:var(--paper);color:var(--ink)}
body{min-height:100%;min-height:100svh;display:flex;overscroll-behavior:none;font:12px/1.4 GeistMono,GeistMonoFallback,GeistMonoFallbackWin,GeistMonoFallbackLinux,Menlo,Consolas,monospace;-webkit-font-smoothing:antialiased}
header{margin:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;padding:24px;text-align:center}
h1{font:inherit;margin:0;font-weight:400;text-transform:uppercase;white-space:nowrap}
nav{display:flex;justify-content:center;gap:28px}
a{color:inherit;text-decoration:none;text-transform:uppercase}
/* Each link is at least a 44px tap target without moving anything: padding grows its
   box past 44px and an equal negative margin keeps its place in the layout. The span
   keeps the link's original box, so the focus ring is drawn exactly where it was. */
nav a{padding-block:14px;margin-block:-14px}
nav a span{display:block}
a:hover{text-decoration:underline;text-underline-offset:4px}
a:focus-visible{outline:none}
a:focus-visible span{outline:1px solid currentColor;outline-offset:5px}
@media(max-width:600px){header{padding:20px 16px}nav{gap:28px}}
</style>
{% include "colorway-head.njk" %}
</head>
<body>
<header>
<h1>Cole Calfee</h1>
<nav aria-label="Primary"><a href="/index/"><span>Index</span></a><a href="/info/"><span>Contact</span></a></nav>
</header>
{% include "colorway-toggle.njk" %}
</body>
