{% comment %}
  Gallery product experience. See shopify/INSTALL.md before installing.
  Shopify renders every purchase state; JavaScript only enhances navigation/media.
{% endcomment %}
{{ 'cole-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cole-gallery.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign artwork_kind = product.metafields.artwork.kind.value
  assign form_id = 'ColeProductForm-' | append: section.id
  assign title_id = 'ColeTitle-' | append: section.id
  assign images = product.media | where: 'media_type', 'image'
  assign lead_image = current_variant.featured_media.preview_image | default: product.featured_image
  assign return_url = product.metafields.artwork.gallery_url.value | default: section.settings.paintings_url
  assign status = 'Available'
  if current_variant == blank
    assign status = 'This combination is unavailable'
  elsif current_variant.available == false
    assign status = 'Sold out'
    if artwork_kind == 'original'
      assign status = 'Sold'
    endif
  endif
-%}
<cole-artwork class="cc-gallery" id="ColeArtwork-{{ section.id }}" data-section-id="{{ section.id }}" aria-labelledby="{{ title_id }}">
  {%- if section.settings.show_navigation -%}
    {% render 'cole-gallery-navigation', section: section %}
  {%- endif -%}
  <div class="cc-gallery__shell">
    <a class="cc-gallery__return" href="{{ return_url | escape }}">&larr; {% if artwork_kind == 'edition' %}Return to the gallery{% else %}Return to paintings{% endif %}</a>
    <div class="cc-gallery__product">
      {% render 'cole-artwork-media', product: product, images: images, lead_image: lead_image, section_id: section.id %}
      <div class="cc-gallery__details" id="ColeDetails-{{ section.id }}">
        <p class="cc-gallery__eyebrow">{% case artwork_kind %}{% when 'original' %}Original painting{% when 'edition' %}Editioned print{% else %}Artwork{% endcase %}</p>
        <h1 id="{{ title_id }}">{{ product.title | escape }}</h1>
        {% render 'cole-artwork-facts', product: product, variant: current_variant, artwork_kind: artwork_kind %}
        <div class="cc-gallery__purchase" data-purchase>
          {% unless product.has_only_default_variant %}
            {% render 'cole-artwork-options', product: product, section_id: section.id %}
          {% endunless %}
          <div class="cc-gallery__price-row">
            <p class="cc-gallery__price" data-price>{% if current_variant %}{{ current_variant.price | money_with_currency }}{% else %}&mdash;{% endif %}</p>
            <p class="cc-gallery__availability" data-availability>{{ status }}</p>
          </div>
          {%- form 'product', product, id: form_id, class: 'cc-gallery__form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" {% unless current_variant %}disabled{% endunless %}>
            {% if artwork_kind == 'original' %}
              <input type="hidden" name="quantity" value="1">
            {% elsif current_variant %}
              <div class="cc-gallery__quantity">
                <label for="ColeQuantity-{{ section.id }}">Quantity</label>
                <input id="ColeQuantity-{{ section.id }}" type="number" name="quantity" inputmode="numeric"
                  value="{{ current_variant.quantity_rule.min | default: 1 }}" min="{{ current_variant.quantity_rule.min | default: 1 }}"
                  step="{{ current_variant.quantity_rule.increment | default: 1 }}"
                  {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %} required>
              </div>
            {% endif %}
            <button class="cc-gallery__buy" type="submit" name="add" {% unless current_variant.available %}disabled{% endunless %} {% if product.requires_selling_plan %}disabled{% endif %}>
              <span>{% if product.requires_selling_plan %}Purchase options required{% elsif current_variant == blank %}Unavailable combination{% elsif current_variant.available %}Add to cart{% else %}{{ status }}{% endif %}</span><span aria-hidden="true">&rarr;</span>
            </button>
            {% if form.errors %}<div class="cc-gallery__error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          {%- endform -%}
          {% if shop.shipping_policy.body != blank %}<p class="cc-gallery__policy"><a href="{{ shop.shipping_policy.url }}">Shipping information</a></p>{% endif %}
        </div>
        {% if product.description != blank %}<div class="cc-gallery__description">{{ product.description }}</div>{% endif %}
        {% if product.metafields.artwork.fulfillment.value != blank %}
          <details class="cc-gallery__disclosure"><summary>Delivery &amp; care</summary><div>{{ product.metafields.artwork.fulfillment | metafield_tag }}</div></details>
        {% endif %}
        {% for block in section.blocks %}{% render block %}{% endfor %}
      </div>
    </div>
    {% if section.settings.show_navigation %}
      <footer class="cc-gallery__footer"><a href="{{ section.settings.home_url | escape }}">&copy; {{ 'now' | date: '%Y' }} Cole Calfee</a><a href="{{ routes.cart_url }}">View cart ({{ cart.item_count }})</a></footer>
    {% endif %}
  </div>
  <p class="cc-gallery__sr" role="status" aria-live="polite" aria-atomic="true" data-announcement></p>
</cole-artwork>
{% schema %}
{
  "name": "Cole artwork product",
  "tag": "section",
  "enabled_on": {"templates": ["product"]},
  "limit": 1,
  "settings": [
    {"type": "checkbox", "id": "show_navigation", "label": "Show gallery navigation", "default": false, "info": "Enable with the cole-gallery layout. Avoid a second theme header."},
    {"type": "url", "id": "home_url", "label": "Portfolio home", "default": "https://colecalfee.com"},
    {"type": "url", "id": "index_url", "label": "Work index", "default": "https://colecalfee.com/index/"},
    {"type": "url", "id": "paintings_url", "label": "Paintings", "default": "https://colecalfee.com/paintings/"},
    {"type": "url", "id": "about_url", "label": "About", "default": "https://colecalfee.com/info/"}
  ],
  "blocks": [{"type": "@app"}],
  "presets": [{"name": "Cole artwork product"}]
}
{% endschema %}
